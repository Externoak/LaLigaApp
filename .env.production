# Keep the CRA runtime chunk as a separate file instead of an inline
# <script>, so the Content-Security-Policy served with production builds
# (script-src 'self' — see server/index.js and docker/nginx.conf) holds.
INLINE_RUNTIME_CHUNK=false

# No sourcemaps in production: shrinks build/ (and the Electron zip that
# packages it) by ~3MB and speeds up CI builds.
GENERATE_SOURCEMAP=false
